<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NiCar</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
@if (ViewContext.RouteData.Values["controller"]?.ToString() != "Home")
{
 <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4"><div class="container-fluid">
 <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-ni">Ni</span>Car</a>
 <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button>
 <div class="collapse navbar-collapse" id="menu">
 <ul class="navbar-nav me-auto">
 @if (User.IsInRole("SuperAdministrador") || User.IsInRole("Administrador"))
 {
  <li class="nav-item"><a class="nav-link" asp-controller="Vehiculos" asp-action="Index">Inventario</a></li>
  <li class="nav-item"><a class="nav-link" asp-controller="Kardex" asp-action="Index">Kardex</a></li>
  <li class="nav-item"><a class="nav-link" asp-controller="Ventas" asp-action="Index">Ventas</a></li>
  <li class="nav-item"><a class="nav-link" asp-controller="Clientes" asp-action="Index">Clientes</a></li>
  <li class="nav-item"><a class="nav-link" asp-controller="Marcas" asp-action="Index">Marcas</a></li>
  <li class="nav-item"><a class="nav-link" asp-controller="Modelos" asp-action="Index">Modelos</a></li>
  <li class="nav-item"><a class="nav-link" asp-controller="Proveedores" asp-action="Index">Proveedores</a></li>
  <li class="nav-item"><a class="nav-link" asp-controller="Adquisiciones" asp-action="Index">Adquisiciones</a></li>
  <li class="nav-item"><a class="nav-link" asp-controller="TipoCostos" asp-action="Index">Tipos de costo</a></li>
  <li class="nav-item"><a class="nav-link" asp-controller="CostosVehiculo" asp-action="Index">Costos</a></li>
  <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Cuentas del personal</a></li>
  @if (User.IsInRole("SuperAdministrador")) { <li class="nav-item"><a class="nav-link" asp-controller="Seguridad" asp-action="Logs">Auditoría</a></li> }
 }
 else if (User.IsInRole("Vendedor"))
 {
  <li class="nav-item"><a class="nav-link" asp-controller="Vehiculos" asp-action="Index">Inventario</a></li><li class="nav-item"><a class="nav-link" asp-controller="Ventas" asp-action="Index">Ventas</a></li><li class="nav-item"><a class="nav-link" asp-controller="Clientes" asp-action="Index">Clientes</a></li>
 }
 else if (User.IsInRole("Bodega"))
 {
  <li class="nav-item"><a class="nav-link" asp-controller="Vehiculos" asp-action="Index">Inventario</a></li><li class="nav-item"><a class="nav-link" asp-controller="Kardex" asp-action="Index">Kardex</a></li>
 }
 else if (User.IsInRole("Recepcionista"))
 {
  <li class="nav-item"><a class="nav-link" asp-controller="Clientes" asp-action="Index">Clientes</a></li>
 }
 @if (User.IsInRole("Administrador") || User.IsInRole("SuperAdministrador") || User.IsInRole("Vendedor") || User.IsInRole("Recepcionista"))
 { <li class="nav-item"><a class="nav-link" asp-controller="Citas" asp-action="Index">Agenda de visitas</a></li> }
 </ul>
 <div class="d-flex align-items-center gap-3">
 @if (User.Identity?.IsAuthenticated == true) {
 <a class="nav-link text-light" asp-controller="Usuarios" asp-action="CambiarContrasena">Cambiar contraseña</a>
 <span class="navbar-text text-white">@User.Identity?.Name (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
 <form asp-controller="Acceso" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline-light btn-sm">Cerrar sesión</button></form>
 } else { <a class="nav-link text-light" asp-controller="Home" asp-action="Index">Volver al catálogo</a> }
 </div></div></div></nav>
}
</header>
<main class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "" : "container pb-4")">
@if (TempData["Mensaje"] != null) { <div class="alert alert-success">@TempData["Mensaje"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
@RenderBody()
</main>
<footer class="site-footer"><div class="container">© 2026 NiCar · Autos usados en Nicaragua</div></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
