@model IEnumerable<NiCar.Models.Marca>

@{
    ViewData["Title"] = "Marcas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Marcas de vehículos</h2>
        <p class="text-muted">Administración de marcas registradas.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Registrar marca
    </a>
</div>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>País de origen</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var marca in Model)
        {
            <tr>
                <td>@marca.IdMarca</td>
                <td>@marca.Nombre</td>
                <td>@marca.PaisOrigen</td>

                <td>
                    @if (marca.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@marca.IdMarca"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <form asp-action="CambiarEstado"
                          asp-route-id="@marca.IdMarca"
                          method="post"
                          class="d-inline">

                        <button type="submit"
                                class="btn btn-sm @(marca.Activo ? "btn-danger" : "btn-success")">
                            @(marca.Activo ? "Desactivar" : "Activar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
