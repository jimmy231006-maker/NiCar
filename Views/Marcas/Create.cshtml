@model NiCar.Models.Marca

@{
    ViewData["Title"] = "Registrar marca";
}

<h2>Registrar marca</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">Nombre de la marca</label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej. Toyota" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PaisOrigen" class="form-label">País de origen</label>
                <input asp-for="PaisOrigen" class="form-control" placeholder="Ej. Japón" />
                <span asp-validation-for="PaisOrigen" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar marca</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
