@model NiCar.Models.Marca

@{
    ViewData["Title"] = "Editar marca";
}

<h2>Editar marca</h2>

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="IdMarca" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">Nombre de la marca</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PaisOrigen" class="form-label">País de origen</label>
                <input asp-for="PaisOrigen" class="form-control" />
                <span asp-validation-for="PaisOrigen" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Guardar cambios
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
