@model IEnumerable<NiCar.Models.CostoVehiculo>

@{
    ViewData["Title"] = "Costos de vehículos";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Costos de vehículos</h2>
            <p class="text-muted">
                Control de gastos asociados a cada vehículo.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Registrar costo
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-bordered table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Vehículo</th>
                        <th>Tipo de costo</th>
                        <th>Descripción</th>
                        <th>Fecha</th>
                        <th>Monto original</th>
                        <th>Moneda</th>
                        <th>Total en córdobas</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var costo in Model)
                        {
                            <tr>
                                <td>@costo.IdCosto</td>

                                <td>
                                    @costo.Vehiculo?.IdentificadorUnico
                                </td>

                                <td>
                                    @costo.TipoCosto?.Nombre
                                </td>

                                <td>@costo.Descripcion</td>

                                <td>
                                    @costo.FechaCosto.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @costo.Monto.ToString("N2")
                                </td>

                                <td>@costo.Moneda</td>

                                <td>
                                    @((costo.MontoNIO ?? 0).ToString("N2")) C$
                                </td>

                                <td>
                                    @if (costo.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit"
                                           asp-route-id="@costo.IdCosto"
                                           class="btn btn-sm btn-warning">
                                            Editar
                                        </a>

                                        <form asp-action="CambiarEstado"
                                              asp-route-id="@costo.IdCosto"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm @(costo.Activo ? "btn-danger" : "btn-success")">
                                                @(costo.Activo ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted">
                                No hay costos registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
