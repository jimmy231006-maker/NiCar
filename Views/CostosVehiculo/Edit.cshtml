@model NiCar.Models.CostoVehiculo

@{
    ViewData["Title"] = "Editar costo";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>Editar costo de vehículo</h2>
        <p class="text-muted">
            Modifica la información del gasto registrado.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-warning">
            <h5 class="mb-0">Información del costo</h5>
        </div>

        <div class="card-body">
            <form asp-action="Edit"
                  asp-route-id="@Model.IdCosto"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="IdCosto" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdVehiculo"
                               class="form-label">Vehículo</label>

                        <select asp-for="IdVehiculo"
                                asp-items="ViewBag.IdVehiculo"
                                class="form-select">
                            <option value="">Seleccione un vehículo</option>
                        </select>

                        <span asp-validation-for="IdVehiculo"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdTipoCosto"
                               class="form-label">Tipo de costo</label>

                        <select asp-for="IdTipoCosto"
                                asp-items="ViewBag.IdTipoCosto"
                                class="form-select">
                            <option value="">Seleccione una categoría</option>
                        </select>

                        <span asp-validation-for="IdTipoCosto"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="Descripcion"
                               class="form-label">Descripción</label>

                        <input asp-for="Descripcion"
                               class="form-control"
                               maxlength="200" />

                        <span asp-validation-for="Descripcion"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="FechaCosto"
                               class="form-label">Fecha del costo</label>

                        <input asp-for="FechaCosto"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="FechaCosto"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Moneda"
                               class="form-label">Moneda</label>

                        <select asp-for="Moneda"
                                class="form-select"
                                id="Moneda">
                            <option value="USD">Dólares (USD)</option>
                            <option value="NIO">Córdobas (NIO)</option>
                        </select>

                        <span asp-validation-for="Moneda"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Monto"
                               class="form-label">Monto</label>

                        <input asp-for="Monto"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />

                        <span asp-validation-for="Monto"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="TasaCambio"
                               class="form-label">Tasa de cambio</label>

                        <input asp-for="TasaCambio"
                               type="number"
                               step="0.000001"
                               min="0.000001"
                               class="form-control"
                               id="TasaCambio" />

                        <span asp-validation-for="TasaCambio"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="NumeroDocumento"
                               class="form-label">
                            Número de documento
                        </label>

                        <input asp-for="NumeroDocumento"
                               class="form-control"
                               maxlength="80" />

                        <span asp-validation-for="NumeroDocumento"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Observaciones"
                               class="form-label">Observaciones</label>

                        <textarea asp-for="Observaciones"
                                  class="form-control"
                                  rows="2"
                                  maxlength="300"></textarea>

                        <span asp-validation-for="Observaciones"
                              class="text-danger"></span>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-warning">
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const moneda = document.getElementById("Moneda");
        const tasa = document.getElementById("TasaCambio");

        function actualizarTasa() {
            if (moneda.value === "NIO") {
                tasa.value = "1";
                tasa.readOnly = true;
            } else {
                tasa.readOnly = false;
            }
        }

        moneda.addEventListener("change", actualizarTasa);
        actualizarTasa();
    </script>
}
