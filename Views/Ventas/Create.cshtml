@model NiCar.Models.VentaFormViewModel
@{ ViewData["Title"] = "Registrar venta"; }
<h2>Registrar venta</h2>
<p class="text-muted">Solo aparecen vehículos activos y disponibles y clientes activos.</p>
<form asp-action="Create" method="post">
 @Html.AntiForgeryToken()
 <div asp-validation-summary="All" class="text-danger mb-3"></div>
 <div class="row g-3">
  <div class="col-md-6"><label asp-for="IdVehiculo" class="form-label">Vehículo</label><select asp-for="IdVehiculo" asp-items="Model.Vehiculos" class="form-select"><option value="">Seleccione vehículo</option></select><span asp-validation-for="IdVehiculo" class="text-danger"></span></div>
  <div class="col-md-6"><label asp-for="IdCliente" class="form-label">Cliente</label><select asp-for="IdCliente" asp-items="Model.Clientes" class="form-select"><option value="">Seleccione cliente</option></select><span asp-validation-for="IdCliente" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="PrecioVenta" class="form-label">Precio de venta</label><input asp-for="PrecioVenta" type="number" min="0.01" step="0.01" class="form-control"/><span asp-validation-for="PrecioVenta" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="Descuento" class="form-label">Descuento</label><input asp-for="Descuento" type="number" min="0" step="0.01" class="form-control"/><span asp-validation-for="Descuento" class="text-danger"></span></div>
  <div class="col-md-4"><label asp-for="Moneda" class="form-label">Moneda</label><select asp-for="Moneda" class="form-select"><option value="NIO">Córdobas (NIO)</option><option value="USD">Dólares (USD)</option></select></div>
  <div class="col-md-6"><label asp-for="MetodoPago" class="form-label">Forma de pago</label><select asp-for="MetodoPago" class="form-select"><option>Efectivo</option><option>Transferencia</option><option>Tarjeta</option><option>Financiamiento</option></select></div>
  <div class="col-md-6"><label asp-for="ReferenciaPago" class="form-label">Referencia de pago</label><input asp-for="ReferenciaPago" class="form-control" maxlength="80"/></div>
  <div class="col-12"><label asp-for="Observaciones" class="form-label">Observaciones</label><textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="500"></textarea></div>
 </div>
 <div class="mt-3"><button class="btn btn-primary">Guardar venta</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
