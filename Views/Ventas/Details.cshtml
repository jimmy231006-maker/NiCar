@model NiCar.Models.Venta
@{ ViewData["Title"] = "Comprobante de venta"; }
<div class="d-flex justify-content-between align-items-center"><h2>Comprobante de venta</h2><button class="btn btn-outline-secondary" onclick="window.print()">Imprimir</button></div>
<div class="card mt-3"><div class="card-body">
<div class="d-flex justify-content-between"><h4>NiCar</h4><strong>@Model.NumeroComprobante</strong></div><hr/>
<p><strong>Fecha:</strong> @Model.FechaVenta.ToString("dd/MM/yyyy")</p>
<h5>Datos del cliente</h5>
<p>@(Model.Cliente?.TipoCliente == "Natural" ? $"{Model.Cliente.Nombres} {Model.Cliente.Apellidos}" : Model.Cliente?.RazonSocial)<br/>Identificación: @Model.Cliente?.TipoIdentificacion @Model.Cliente?.NumeroIdentificacion<br/>Teléfono: @Model.Cliente?.Telefono</p>
<h5>Vehículo vendido</h5>
<p>Código: @Model.Vehiculo?.IdentificadorUnico<br/>Marca: @Model.Vehiculo?.Modelo?.Marca?.Nombre<br/>Modelo: @Model.Vehiculo?.Modelo?.Nombre<br/>Año: @Model.Vehiculo?.Anio<br/>VIN: @Model.Vehiculo?.VIN</p>
<table class="table"><tr><th>Precio</th><td class="text-end">@Model.Moneda @Model.PrecioVenta.ToString("N2")</td></tr><tr><th>Descuento</th><td class="text-end">@Model.Moneda @Model.Descuento.ToString("N2")</td></tr><tr><th>Total</th><td class="text-end fw-bold">@Model.Moneda @Model.Total.ToString("N2")</td></tr></table>
<p><strong>Forma de pago:</strong> @Model.MetodoPago</p><p><strong>Referencia:</strong> @Model.ReferenciaPago</p><p>@Model.Observaciones</p>
</div></div>
<a asp-action="Index" class="btn btn-secondary mt-3">Volver a ventas</a>
