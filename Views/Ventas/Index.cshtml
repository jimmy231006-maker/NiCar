@model IEnumerable<NiCar.Models.Venta>
@{ ViewData["Title"] = "Ventas"; }
<div class="d-flex justify-content-between align-items-center mb-3">
 <div><h2>Ventas</h2><p class="text-muted">Historial de ventas de vehículos y comprobantes.</p></div>
 <a asp-action="Create" class="btn btn-primary">Registrar venta</a>
</div>
<form method="get" class="row g-2 mb-3">
 <div class="col-md-4"><input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Comprobante, cliente o vehículo"/></div>
 <div class="col-md-3"><input type="date" name="desde" value="@ViewBag.Desde" class="form-control"/></div>
 <div class="col-md-3"><input type="date" name="hasta" value="@ViewBag.Hasta" class="form-control"/></div>
 <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filtrar</button></div>
</form>
<div class="table-responsive"><table class="table table-striped table-bordered">
<thead class="table-dark"><tr><th>Comprobante</th><th>Fecha</th><th>Vehículo</th><th>Cliente</th><th>Total</th><th>Pago</th><th></th></tr></thead>
<tbody>
@foreach (var v in Model) {
<tr>
<td>@v.NumeroComprobante</td><td>@v.FechaVenta.ToString("dd/MM/yyyy")</td>
<td>@v.Vehiculo?.IdentificadorUnico - @v.Vehiculo?.Modelo?.Marca?.Nombre @v.Vehiculo?.Modelo?.Nombre</td>
<td>@(v.Cliente?.TipoCliente == "Natural" ? $"{v.Cliente.Nombres} {v.Cliente.Apellidos}" : v.Cliente?.RazonSocial)</td>
<td>@v.Moneda @v.Total.ToString("N2")</td><td>@v.MetodoPago</td>
<td><a asp-action="Details" asp-route-id="@v.IdVenta" class="btn btn-sm btn-outline-primary">Ver comprobante</a></td>
</tr>
}
@if (!Model.Any()) { <tr><td colspan="7" class="text-center">No hay ventas registradas.</td></tr> }
</tbody></table></div>
