@model NiCar.Models.Cliente
@{ ViewData["Title"] = ViewContext.RouteData.Values["action"]?.ToString() == "Edit" ? "Editar cliente" : "Nuevo cliente"; }
<h2>@ViewData["Title"]</h2>
<form method="post">
@Html.AntiForgeryToken()
<input asp-for="IdCliente" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-3">
<div class="col-md-4"><label asp-for="TipoCliente" class="form-label">Tipo de cliente</label><select asp-for="TipoCliente" class="form-select"><option value="Natural">Natural</option><option value="Juridica">Jurídica</option></select></div>
<div class="col-md-4"><label asp-for="Nombres" class="form-label"></label><input asp-for="Nombres" class="form-control" maxlength="100"/><span asp-validation-for="Nombres" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Apellidos" class="form-label"></label><input asp-for="Apellidos" class="form-control" maxlength="100"/><span asp-validation-for="Apellidos" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="RazonSocial" class="form-label"></label><input asp-for="RazonSocial" class="form-control" maxlength="150"/></div>
<div class="col-md-3"><label asp-for="TipoIdentificacion" class="form-label">Tipo identificación</label><select asp-for="TipoIdentificacion" class="form-select"><option value="">Seleccione</option><option>Cedula</option><option>RUC</option><option>Pasaporte</option><option>Otro</option></select></div>
<div class="col-md-3"><label asp-for="NumeroIdentificacion" class="form-label">Numero de identificacion</label><input asp-for="NumeroIdentificacion" class="form-control" maxlength="30" placeholder="000-DDMMYY-0000A"/><span asp-validation-for="NumeroIdentificacion" class="text-danger"></span><small class="text-muted">Para cedula nicaraguense: 000-DDMMYY-0000A. Se valida codigo municipal, fecha y edad minima de 16 anios. En ventas, menores de 18 requieren excepcion legal documentada.</small></div>
<div class="col-md-4"><label asp-for="Telefono" class="form-label"></label><input asp-for="Telefono" class="form-control" maxlength="20"/></div>
<div class="col-md-4"><label asp-for="Correo" class="form-label"></label><input asp-for="Correo" class="form-control" maxlength="120"/></div>
<div class="col-md-4"><label asp-for="Direccion" class="form-label"></label><input asp-for="Direccion" class="form-control" maxlength="300"/></div>
</div><div class="mt-3"><button class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
</form>
