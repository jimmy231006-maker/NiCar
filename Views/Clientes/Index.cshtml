@model IEnumerable<NiCar.Models.Cliente>
@{ ViewData["Title"] = "Clientes"; }
<div class="d-flex justify-content-between align-items-center mb-3">
<h2>Clientes</h2><a asp-action="Create" class="btn btn-primary">Nuevo cliente</a></div>
<form method="get" class="mb-3"><select name="filtro" class="form-select w-auto d-inline">
<option>Todos</option><option selected="@(ViewBag.Filtro == "Activos")">Activos</option><option selected="@(ViewBag.Filtro == "Inactivos")">Inactivos</option>
</select><button class="btn btn-secondary">Filtrar</button></form>
<div class="table-responsive"><table class="table table-striped">
<thead><tr><th>ID</th><th>Tipo</th><th>Nombre / Razón social</th><th>Identificación</th><th>Teléfono</th><th>Estado</th><th></th></tr></thead>
<tbody>@foreach(var c in Model){<tr>
<td>@c.IdCliente</td><td>@c.TipoCliente</td><td>@(c.TipoCliente=="Natural" ? $"{c.Nombres} {c.Apellidos}" : c.RazonSocial)</td>
<td>@c.TipoIdentificacion @c.NumeroIdentificacion</td><td>@c.Telefono</td><td>@(c.Activo?"Activo":"Inactivo")</td>
<td><a asp-action="Edit" asp-route-id="@c.IdCliente" class="btn btn-sm btn-outline-primary">Editar</a>
<form asp-action="CambiarEstado" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.IdCliente"/><button class="btn btn-sm btn-outline-warning">@(c.Activo?"Desactivar":"Reactivar")</button></form></td>
</tr>}</tbody></table></div>
