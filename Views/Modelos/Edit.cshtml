@model NiCar.Models.Modelo

@{
    ViewData["Title"] = "Editar modelo";
}

<h2>Editar modelo</h2>

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="IdModelo" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="IdMarca" class="form-label">Marca del vehículo</label>

                <select asp-for="IdMarca"
                        asp-items="ViewBag.IdMarca"
                        class="form-select">
                    <option value="">Seleccione una marca</option>
                </select>

                <span asp-validation-for="IdMarca" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">Nombre del modelo</label>

                <input asp-for="Nombre" class="form-control" />

                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Guardar cambios
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

