@model IEnumerable<NiCar.Models.Modelo>

@{
    ViewData["Title"] = "Modelos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Modelos de vehículos</h2>
        <p class="text-muted">Administración de modelos por marca.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Registrar modelo
    </a>
</div>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var modelo in Model)
        {
            <tr>
                <td>@modelo.IdModelo</td>
                <td>@modelo.Marca?.Nombre</td>
                <td>@modelo.Nombre</td>
                <td>
                    @if (modelo.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@modelo.IdModelo"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <form asp-action="CambiarEstado"
                          asp-route-id="@modelo.IdModelo"
                          method="post"
                          class="d-inline">

                        <button type="submit"
                                class="btn btn-sm @(modelo.Activo ? "btn-danger" : "btn-success")">
                            @(modelo.Activo ? "Desactivar" : "Activar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

