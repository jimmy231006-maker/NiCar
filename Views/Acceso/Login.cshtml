@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="text-center mb-3">NiCar</h2>
                <p class="text-center text-muted">Inicie sesión para continuar</p>
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label">Usuario</label>
                        <input name="nombreUsuario" class="form-control" autocomplete="username" required maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input name="contrasena" type="password" class="form-control" autocomplete="current-password" required />
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Ingresar</button>
                </form>
                <a class="d-block mt-3" asp-action="Registro" asp-route-returnUrl="@ViewBag.ReturnUrl">Crear cuenta de cliente</a>
            </div>
        </div>
    </div>
</div>
