@model IEnumerable<NiCar.Models.TipoCosto>

@{
    ViewData["Title"] = "Tipos de costos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Tipos de costos</h2>
            <p class="text-muted">
                Administración de categorías de gastos de vehículos.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Nuevo tipo de costo
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var tipo in Model)
                            {
                                <tr>
                                    <td>@tipo.IdTipoCosto</td>
                                    <td>@tipo.Nombre</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(tipo.Descripcion)
                                                                        ? "Sin descripción"
                                                                        : tipo.Descripcion)
                            </td>
                            <td>
                                @if (tipo.Activo)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Edit"
                                               asp-route-id="@tipo.IdTipoCosto"
                                               class="btn btn-sm btn-warning">
                                                Editar
                                            </a>

                                            <form asp-action="CambiarEstado"
                                                  asp-route-id="@tipo.IdTipoCosto"
                                                  method="post">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm @(tipo.Activo ? "btn-danger" : "btn-success")">
                                                    @(tipo.Activo ? "Desactivar" : "Activar")
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    No hay tipos de costos registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

