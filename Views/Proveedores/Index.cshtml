@model IEnumerable<NiCar.Models.Proveedor>
@{ ViewData["Title"]="Proveedores"; }
<div class="d-flex justify-content-between mb-3"><h2>Proveedores</h2><a asp-action="Create" class="btn btn-primary">Nuevo proveedor</a></div>
<form method="get" class="mb-3"><select name="filtro" class="form-select w-auto d-inline"><option>Todos</option><option selected="@(ViewBag.Filtro=="Activos")">Activos</option><option selected="@(ViewBag.Filtro=="Inactivos")">Inactivos</option></select><button class="btn btn-secondary">Filtrar</button></form>
<table class="table table-striped"><thead><tr><th>Proveedor</th><th>Tipo</th><th>Identificación</th><th>País</th><th>Teléfono</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach(var p in Model){<tr><td>@p.NombreProveedor</td><td>@p.TipoProveedor</td><td>@p.IdentificacionFiscal</td><td>@p.Pais</td><td>@p.Telefono</td><td>@(p.Activo?"Activo":"Inactivo")</td><td>
<a asp-action="Edit" asp-route-id="@p.IdProveedor" class="btn btn-sm btn-outline-primary">Editar</a>
<form asp-action="CambiarEstado" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.IdProveedor"/><button class="btn btn-sm btn-outline-warning">@(p.Activo?"Desactivar":"Reactivar")</button></form>
</td></tr>}
</tbody></table>
