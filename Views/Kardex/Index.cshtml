@model IReadOnlyList<NiCar.Models.KardexFila>
@{ ViewData["Title"] = "Kardex de inventario"; }
<div class="mb-4"><p class="eyebrow">BODEGA</p><h1 class="h2">Kardex de inventario</h1><p class="text-muted">Entradas por compra y salidas por venta de vehículos.</p></div>
<div class="table-responsive bg-white rounded-3 shadow-sm"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Fecha</th><th>Movimiento</th><th>Referencia</th><th>Vehículo</th><th>Monto</th><th></th></tr></thead><tbody>
@foreach (var row in Model) { <tr><td>@row.Fecha.ToString("dd/MM/yyyy")</td><td><span class="badge @(row.Movimiento == "Entrada" ? "text-bg-success" : "text-bg-warning")">@row.Movimiento</span></td><td>@row.Referencia</td><td>@row.Vehiculo</td><td>@(row.Monto?.ToString("N2") ?? "—") @row.Moneda</td><td>@(row.Movimiento == "Entrada" ? "+1" : "−1") unidad</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-5">Aún no hay movimientos de inventario.</td></tr> }
</tbody></table></div>
