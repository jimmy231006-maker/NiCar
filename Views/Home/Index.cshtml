@model IReadOnlyList<NiCar.Models.CatalogoVehiculoViewModel>
@{
    ViewData["Title"] = "Autos usados en Nicaragua";
    var query = ViewBag.Busqueda as string;
}
<section class="catalog-hero">
    <div class="catalog-top container">
        <a class="brand-mark" asp-controller="Home" asp-action="Index"><span>Ni</span>Car</a>
        <form asp-controller="Home" asp-action="Index" method="get" class="catalog-search">
            <input type="search" name="q" value="@query" placeholder="Buscar autos por marca, modelo o año" aria-label="Buscar autos" />
            <button type="submit" aria-label="Buscar">⌕</button>
        </form>
    </div>
    <nav class="catalog-nav container">
        <div class="catalog-links"><a asp-action="Index">Catálogo de vehículos</a></div>
        <div class="catalog-account">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span>@User.Identity.Name</span>@if (User.IsInRole("Bodega")) { <a asp-controller="Vehiculos" asp-action="Index">Inventario</a> }
            else if (!User.IsInRole("Cliente")) { <a asp-controller="Citas" asp-action="Index">Agenda de visitas</a> }
            <form asp-controller="Acceso" asp-action="Logout" method="post"><button type="submit" class="btn btn-link">Cerrar sesión</button></form>
        }
        else { <a class="login-link" asp-controller="Acceso" asp-action="Login">Iniciar sesión</a> <a asp-controller="Acceso" asp-action="Registro">Crear cuenta</a> }
        </div>
    </nav>
</section>
<main class="container catalog-main">
    <div class="catalog-heading"><div><p class="eyebrow">AUTOS USADOS EN NICARAGUA</p><h1>Autos destacados recientes en <span>Nicaragua</span></h1><p class="catalog-subtitle">Explorá los vehículos disponibles y agendá una visita para verlos en persona.</p></div>
      @if (User.IsInRole("SuperAdministrador") || User.IsInRole("Administrador")) { <a class="btn-outline-orange" asp-controller="Vehiculos" asp-action="Create">+ Agregar vehículo</a> }
    </div>
    @if (Model.Count == 0)
    {
        <div class="catalog-empty"><div class="empty-icon">🚘</div><h2>@(string.IsNullOrWhiteSpace(query) ? "Pronto encontrarás autos aquí" : "No encontramos resultados")</h2><p>@(string.IsNullOrWhiteSpace(query) ? "El inventario disponible aparecerá en este catálogo." : "Prueba con otra marca, modelo o año.")</p></div>
    }
    else
    {
      <div class="vehicle-grid">
      @foreach (var car in Model)
      {
        <article class="vehicle-card">
          <a class="vehicle-photo" asp-controller="Vehiculos" asp-action="Details" asp-route-id="@car.IdVehiculo" aria-label="Ver @car.Marca @car.Modelo">
            @if (!string.IsNullOrWhiteSpace(car.ImagenUrl)) { <img src="@car.ImagenUrl" alt="@car.Marca @car.Modelo" loading="lazy" /> }
            else { <div class="photo-placeholder"><span>NiCar</span><small>Imagen disponible próximamente</small></div> }
            <span class="featured-tag">DISPONIBLE</span>
          </a>
          <div class="vehicle-info"><h2>@car.Anio @car.Marca @car.Modelo</h2>
            <p><span class="info-icon">◎</span> Nicaragua</p>
            <p><span class="info-icon">●</span> @(string.IsNullOrWhiteSpace(car.Ubicacion) ? "Ubicación por confirmar" : car.Ubicacion)</p>
            <p><span class="info-icon">♙</span> NiCar</p>
            <p><span class="info-icon">◴</span> @car.Kilometraje.ToString("N0") km</p>
            @if (!string.IsNullOrWhiteSpace(car.Transmision) || !string.IsNullOrWhiteSpace(car.Combustible)) { <p class="vehicle-spec">@car.Transmision · @car.Combustible</p> }
          </div>
          <div class="vehicle-price">
            <strong>@(car.PrecioOferta.HasValue ? $"USD {car.PrecioOferta.Value:N0}" : "Consultar precio")</strong>
            <a asp-controller="Vehiculos" asp-action="Details" asp-route-id="@car.IdVehiculo" class="offer-button">Ver vehículo</a>
          </div>
        </article>
      }
      </div>
    }
</main>
