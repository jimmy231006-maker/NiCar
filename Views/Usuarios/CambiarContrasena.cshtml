@model NiCar.Models.CambiarContrasenaViewModel
@{ ViewData["Title"] = "Cambiar contraseña"; }
<div class="form-shell"><p class="eyebrow">SEGURIDAD DE LA CUENTA</p><h1 class="h2">@(User.FindFirst("NiCar.DebeCambiarContrasena")?.Value == "true" ? "Define tu contraseña" : "Cambiar contraseña")</h1><p class="text-muted">Elige una contraseña segura de al menos 12 caracteres.</p>
<form asp-action="CambiarContrasena" method="post" class="mt-4"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
 <div class="mb-3"><label asp-for="ContrasenaActual" class="form-label"></label><input asp-for="ContrasenaActual" class="form-control" autocomplete="current-password"/><span asp-validation-for="ContrasenaActual" class="text-danger"></span></div>
 <div class="mb-3"><label asp-for="ContrasenaNueva" class="form-label"></label><input asp-for="ContrasenaNueva" class="form-control" autocomplete="new-password"/><span asp-validation-for="ContrasenaNueva" class="text-danger"></span></div>
 <div class="mb-4"><label asp-for="ConfirmarContrasena" class="form-label"></label><input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmarContrasena" class="text-danger"></span></div>
 @Html.AntiForgeryToken()<button class="btn btn-orange">Guardar contraseña</button>
</form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
