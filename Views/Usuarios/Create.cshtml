@model NiCar.Models.UsuarioCrearViewModel
@{ ViewData["Title"] = "Crear cuenta de personal"; }
<div class="form-shell"><a asp-action="Index" class="back-link">← Cuentas del personal</a><p class="eyebrow mt-4">NUEVO ACCESO</p><h1 class="h2">Crear cuenta</h1><p class="text-muted">La persona deberá cambiar esta contraseña temporal en su primer ingreso.</p>
<form asp-action="Create" method="post" class="mt-4"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
 <div class="mb-3"><label asp-for="NombreCompleto" class="form-label"></label><input asp-for="NombreCompleto" class="form-control" autocomplete="name"/><span asp-validation-for="NombreCompleto" class="text-danger"></span></div>
 <div class="mb-3"><label asp-for="Correo" class="form-label"></label><input asp-for="Correo" class="form-control" autocomplete="email"/><span asp-validation-for="Correo" class="text-danger"></span></div>
 <div class="mb-3"><label asp-for="Rol" class="form-label">Rol del sistema</label><select asp-for="Rol" asp-items="Model.Roles" class="form-select"></select><span asp-validation-for="Rol" class="text-danger"></span></div>
 <div class="mb-4"><label asp-for="Contrasena" class="form-label">Contraseña temporal</label><input asp-for="Contrasena" class="form-control" autocomplete="new-password"/><div class="form-text">Usa al menos 12 caracteres.</div><span asp-validation-for="Contrasena" class="text-danger"></span></div>
 @Html.AntiForgeryToken()<button class="btn btn-orange">Crear cuenta</button> <a asp-action="Index" class="btn btn-light">Cancelar</a>
</form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
