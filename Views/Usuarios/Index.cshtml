@model IReadOnlyList<NiCar.Models.UsuarioListaFila>
@{ ViewData["Title"] = "Cuentas del personal"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="eyebrow">SEGURIDAD</p><h1 class="h2">Cuentas del personal</h1><p class="text-muted mb-0">Administra el acceso de administradores y vendedores.</p></div><a asp-action="Create" class="btn btn-orange">+ Crear cuenta</a></div>
<div class="table-responsive bg-white rounded-3 shadow-sm"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Nombre</th><th>Correo de acceso</th><th>Rol</th><th>Estado</th><th>Creación</th><th></th></tr></thead><tbody>
@foreach (var user in Model)
{
 <tr><td class="fw-semibold">@user.NombreCompleto</td><td>@user.NombreUsuario</td><td><span class="role-pill">@user.Rol</span></td><td><span class="badge @(user.Activo ? "text-bg-success" : "text-bg-secondary")">@(user.Activo ? "Activo" : "Inactivo")</span></td><td>@user.FechaCreacion.ToString("dd/MM/yyyy")</td><td class="text-end"><form asp-action="CambiarEstado" method="post"><input type="hidden" name="id" value="@user.IdUsuario" />@Html.AntiForgeryToken()<button class="btn btn-sm @(user.Activo ? "btn-outline-danger" : "btn-outline-success")">@(user.Activo ? "Desactivar" : "Reactivar")</button></form></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-5">No hay cuentas del personal registradas.</td></tr> }
</tbody></table></div>
