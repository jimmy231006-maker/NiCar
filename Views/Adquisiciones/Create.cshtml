@model NiCar.Models.AdquisicionVehiculo

@{
    ViewData["Title"] = "Registrar adquisición";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Registrar adquisición</h2>
            <p class="text-muted">
                Registra la compra de un vehículo a un proveedor.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Información de la adquisición</h5>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdVehiculo"
                               class="form-label">Vehículo</label>

                        <select asp-for="IdVehiculo"
                                asp-items="ViewBag.IdVehiculo"
                                class="form-select">
                            <option value="">Seleccione un vehículo</option>
                        </select>

                        <span asp-validation-for="IdVehiculo"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdProveedor"
                               class="form-label">Proveedor</label>

                        <select asp-for="IdProveedor"
                                asp-items="ViewBag.IdProveedor"
                                class="form-select">
                            <option value="">Seleccione un proveedor</option>
                        </select>

                        <span asp-validation-for="IdProveedor"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="FechaAdquisicion"
                               class="form-label">
                            Fecha de adquisición
                        </label>

                        <input asp-for="FechaAdquisicion"
                               type="date"
                               class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="FechaAdquisicion"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Moneda"
                               class="form-label">Moneda</label>

                        <select asp-for="Moneda"
                                class="form-select"
                                id="Moneda">
                            <option value="USD">Dólares (USD)</option>
                            <option value="NIO">Córdobas (NIO)</option>
                        </select>

                        <span asp-validation-for="Moneda"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PrecioCompra"
                               class="form-label">
                            Precio de compra
                        </label>

                        <input asp-for="PrecioCompra"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control"
                               placeholder="Ingrese el precio" />

                        <span asp-validation-for="PrecioCompra"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="TasaCambio"
                               class="form-label">
                            Tasa de cambio
                        </label>

                        <input asp-for="TasaCambio"
                               type="number"
                               step="0.000001"
                               min="0.000001"
                               class="form-control"
                               id="TasaCambio"
                               value="36.6243" />

                        <small class="text-muted">
                            Si selecciona NIO, la tasa será 1 automáticamente.
                        </small>

                        <span asp-validation-for="TasaCambio"
                              class="text-danger"></span>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar adquisición
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const moneda = document.getElementById("Moneda");
        const tasa = document.getElementById("TasaCambio");

        function actualizarTasa() {
            if (moneda.value === "NIO") {
                tasa.value = "1";
                tasa.readOnly = true;
            } else {
                tasa.readOnly = false;

                if (Number(tasa.value) === 1) {
                    tasa.value = "36.6243";
                }
            }
        }

        moneda.addEventListener("change", actualizarTasa);
        actualizarTasa();
    </script>
}
